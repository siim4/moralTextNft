# Your wallet private key (export from MetaMask)
# Keep the 0x prefix
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# RPC URL for Sepolia (get from Alchemy or Infura)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Deployed contract address (fill in after deployment)
CONTRACT_ADDRESS=0x_YOUR_CONTRACT_ADDRESS_HERE